# ==============================================
# HCM - Variables de Entorno de Ejemplo
# ==============================================

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=homelab_monitor
DB_USER=admin
DB_PASSWORD=admin123

# PostgreSQL Docker Environment
POSTGRES_DB=homelab_monitor
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# HCM App Configuration (API + Frontend)
PORT=3000
NODE_ENV=development

# Simulador de Métricas Integrado
# true: genera métricas automáticamente para los 5 mini-PCs
# false: desactiva el simulador para recibir métricas únicamente de agentes reales
ENABLE_SIMULATOR=true
METRICS_INTERVAL=5000
